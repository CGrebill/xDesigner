<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AvaloniaVersion>12.1.6</AvaloniaVersion>
    <!-- The Avalonia 11 render host, its sample and the Avalonia 11 project template (VersionOverride). -->
    <Avalonia11Version>11.3.23</Avalonia11Version>
    <!-- The app, the WinUI render host (which reports it in its handshake) and the WinUI project templates. -->
    <WindowsAppSdkVersion>2.7.0</WindowsAppSdkVersion>
    <!-- The .NET MAUI render hosts (Maui11 uses the default; Maui10 a VersionOverride) and the MAUI project templates. -->
    <Maui11Version>11.0.0</Maui11Version>
    <Maui10Version>10.0.130</Maui10Version>
  </PropertyGroup>
  <ItemGroup Label="Avalonia (RenderHost, samples)">
    <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Headless" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Markup.Xaml.Loader" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup Label=".NET MAUI (render hosts)">
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(Maui11Version)" />
  </ItemGroup>
  <ItemGroup Label="Shared infrastructure">
    <PackageVersion Include="StreamJsonRpc" Version="2.26.150" />
    <!-- 2.5.x, not 3.x: StreamJsonRpc's MessagePackFormatter is built against MessagePack 2.5. -->
    <PackageVersion Include="MessagePack" Version="2.5.307" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
  </ItemGroup>
  <ItemGroup Label="WinUI 3 app">
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="$(WindowsAppSdkVersion)" />
    <!-- Components of the metapackage the app doesn't use; referenced only to exclude them (XDesigner.App.csproj). -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.AI" Version="$(WindowsAppSdkVersion)" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.ML" Version="$(WindowsAppSdkVersion)" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Search" Version="$(WindowsAppSdkVersion)" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Widgets" Version="$(WindowsAppSdkVersion)" />
    <PackageVersion Include="Microsoft.Windows.AI.MachineLearning" Version="2.5.96" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
</Project>
