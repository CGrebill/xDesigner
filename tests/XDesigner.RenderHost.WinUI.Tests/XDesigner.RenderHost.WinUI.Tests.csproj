<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests of the WinUI render host, out of process and over the pipe as the designer app talks to it (a WinUI host can't
    run inside a test process). The host runs from a shadow folder of the sample WinUI app's build output (§14.5).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>XDesigner.RenderHost.WinUI.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\XDesigner.Core\XDesigner.Core.csproj" />
    <!-- Built first, then started as processes; not referenced at compile time. -->
    <ProjectReference Include="..\..\src\XDesigner.RenderHost.WinUI\XDesigner.RenderHost.WinUI.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetPlatform="Platform=x64" />
    <ProjectReference Include="..\..\samples\SampleWinUIApp\SampleWinUIApp.csproj"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" SetPlatform="Platform=x64" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
