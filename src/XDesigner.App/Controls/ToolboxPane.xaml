<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XDesigner.App.Controls.ToolboxPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolbox="using:XDesigner.Core.Toolbox">

  <UserControl.Resources>
    <DataTemplate x:Key="ToolboxItemTemplate" x:DataType="toolbox:ToolboxItem">
      <StackPanel Orientation="Horizontal" Spacing="10" ToolTipService.ToolTip="{x:Bind Type.FullName}">
        <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        <TextBlock Text="{x:Bind DisplayName}" />
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <!-- Toolbox (§9.1): drag a control onto the form, or double-click to add it to the selected container. -->
  <Grid RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="Toolbox" Style="{StaticResource PaneTitleStyle}" Margin="12,10,12,0" />
    <TextBox x:Name="SearchBox" Grid.Row="1" Margin="8,0" PlaceholderText="Search controls" TextChanged="SearchBox_TextChanged" />
    <ScrollViewer Grid.Row="2" Padding="4,0,8,8">
      <StackPanel x:Name="CategoryHost" Spacing="2" />
    </ScrollViewer>
    <TextBlock x:Name="EmptyText" Grid.Row="2" Margin="12,4" Style="{StaticResource PanePlaceholderTextStyle}"
               Text="Open a file to see the controls you can add." />
  </Grid>
</UserControl>
