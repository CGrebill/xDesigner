<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="XDesigner.App.Controls.DocumentOutline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:XDesigner.App.ViewModels">

  <!-- Document Outline (§9.6): two-way selection sync, drag to reorder or move into another container, right-click menu. -->
  <Grid x:Name="Root" RowSpacing="4" AllowDrop="True" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="Document Outline" Style="{StaticResource PaneTitleStyle}" Margin="12,10,12,0" />

    <TreeView x:Name="Tree" Grid.Row="1" SelectionMode="Single" CanDragItems="False" CanReorderItems="False" AllowDrop="False"
              RightTapped="Tree_RightTapped"
              SelectionChanged="Tree_SelectionChanged" Expanding="Tree_Expanding" Collapsed="Tree_Collapsed">
      <TreeView.ItemTemplate>
        <DataTemplate x:DataType="vm:OutlineNodeViewModel">
          <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=OneWay}" HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}">
            <Grid ColumnSpacing="4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal" Spacing="6" Opacity="{x:Bind TextOpacity, Mode=OneWay}">
                <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <!-- §9.6: hide a control on the form while designing (view only, the file keeps it). -->
              <Button Grid.Column="1" Click="Eye_Click" Padding="6,2" MinWidth="0" Background="Transparent" BorderThickness="0"
                      IsEnabled="{x:Bind CanHide}" Opacity="{x:Bind EyeOpacity, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind EyeTip, Mode=OneWay}" AutomationProperties.Name="{x:Bind EyeTip, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind EyeGlyph, Mode=OneWay}" FontSize="12" />
              </Button>
            </Grid>
          </TreeViewItem>
        </DataTemplate>
      </TreeView.ItemTemplate>
    </TreeView>

    <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="12,4" Text="Open a file to see its controls."
               Style="{StaticResource PanePlaceholderTextStyle}" />
  </Grid>
</UserControl>
