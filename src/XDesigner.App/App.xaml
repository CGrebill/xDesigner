<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="XDesigner.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Notification strip colors (MainWindow.Notify.cs): calm backgrounds, a clear checkmark/warning/error color. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="NotifySuccessBackground" Color="#1E3528" />
          <SolidColorBrush x:Key="NotifySuccessBorder" Color="#2D5139" />
          <SolidColorBrush x:Key="NotifySuccessIcon" Color="#6CCB5F" />
          <SolidColorBrush x:Key="NotifyWarningBackground" Color="#3A3119" />
          <SolidColorBrush x:Key="NotifyWarningBorder" Color="#5A4A20" />
          <SolidColorBrush x:Key="NotifyWarningIcon" Color="#FCE100" />
          <SolidColorBrush x:Key="NotifyErrorBackground" Color="#3B2224" />
          <SolidColorBrush x:Key="NotifyErrorBorder" Color="#5E3539" />
          <SolidColorBrush x:Key="NotifyErrorIcon" Color="#FF99A4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="NotifySuccessBackground" Color="#E5F4E7" />
          <SolidColorBrush x:Key="NotifySuccessBorder" Color="#BCDEC2" />
          <SolidColorBrush x:Key="NotifySuccessIcon" Color="#0F7B0F" />
          <SolidColorBrush x:Key="NotifyWarningBackground" Color="#FFF4CE" />
          <SolidColorBrush x:Key="NotifyWarningBorder" Color="#F0D88C" />
          <SolidColorBrush x:Key="NotifyWarningIcon" Color="#9D5D00" />
          <SolidColorBrush x:Key="NotifyErrorBackground" Color="#FDE7E9" />
          <SolidColorBrush x:Key="NotifyErrorBorder" Color="#F0B8BE" />
          <SolidColorBrush x:Key="NotifyErrorIcon" Color="#C42B1C" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <Style x:Key="PaneStyle" TargetType="Border">
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>

      <Style x:Key="PaneTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}" />

      <Style x:Key="PanePlaceholderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
