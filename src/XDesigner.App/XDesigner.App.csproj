<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>XDesigner.App</RootNamespace>
    <AssemblyName>xDesigner</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe/taskbar icon; also loaded at runtime for the title bar (AppWindow.SetIcon). Made by tools/make-icon.ps1. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- x64 only: WinUI 3 has no AnyCPU build, and the release ships for x64 (ARM64 Windows runs it emulated). -->
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged exe that bundles the Windows App SDK runtime, so nothing else has to be installed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- Generates and publishes the app's own resources (xDesigner.pri with the compiled XAML) for an unpackaged app. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Description>xDesigner: a visual designer for Avalonia UI, WinUI 3 and .NET MAUI (WinUI 3 shell).</Description>
  </PropertyGroup>

  <!-- Release publish: self-contained (no .NET install needed) and precompiled for a faster start. -->
  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- StreamJsonRpc without the WPF framework it would bring in (~60 MB in a self-contained publish). -->
  <Import Project="..\..\build\VsThreadingWithoutWpf.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <!-- Not used: keeps the AI, machine learning (onnxruntime, DirectML; ~40 MB), Search and Widgets parts out of the app. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" ExcludeAssets="all" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shipped next to the exe for Help › License / Third-party notices (as .txt so they open in a text editor). -->
    <Content Include="..\..\LICENSE.md" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Help › Report a problem and the About box link to the repository. -->
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XDesigner.Core\XDesigner.Core.csproj" />
    <ProjectReference Include="..\XDesigner.Protocol\XDesigner.Protocol.csproj" />
  </ItemGroup>

  <!--
    The render hosts are separate .NET exes, one per framework version, each with its own UI framework dependencies, so
    they are built on their own and placed in "renderhosts\{folder}" next to the app (FrameworkProfile.HostFolder), not
    referenced.
    Build: each host's (framework-dependent) build output is copied into the app's output folder. The Platform metadata
    matches how a solution build builds it (AnyCPU; x64 for WinUI, which has no AnyCPU build), so MSBuild reuses that
    build instead of running a second, conflicting one.
    Publish: each host is published self-contained and precompiled into the publish folder.
  -->
  <ItemGroup>
    <RenderHostProject Include="..\XDesigner.RenderHost.Avalonia\XDesigner.RenderHost.Avalonia12.csproj" Folder="avalonia12" Platform="AnyCPU" />
    <RenderHostProject Include="..\XDesigner.RenderHost.Avalonia11\XDesigner.RenderHost.Avalonia11.csproj" Folder="avalonia11" Platform="AnyCPU" />
    <RenderHostProject Include="..\XDesigner.RenderHost.WinUI\XDesigner.RenderHost.WinUI.csproj" Folder="winui3" Platform="x64" />
    <RenderHostProject Include="..\XDesigner.RenderHost.Maui\XDesigner.RenderHost.Maui11.csproj" Folder="maui11" Platform="x64" />
    <RenderHostProject Include="..\XDesigner.RenderHost.Maui10\XDesigner.RenderHost.Maui10.csproj" Folder="maui10" Platform="x64" />
  </ItemGroup>
  <!-- Batched: runs once per render host (Outputs names each one). -->
  <Target Name="CopyRenderHosts" AfterTargets="Build" Outputs="%(RenderHostProject.Identity)">
    <MSBuild Projects="@(RenderHostProject)" Targets="Build"
             Properties="Configuration=$(Configuration);Platform=%(RenderHostProject.Platform)"
             RemoveProperties="RuntimeIdentifier;SelfContained;TargetFramework;WindowsAppSDKSelfContained;PublishReadyToRun">
      <Output TaskParameter="TargetOutputs" ItemName="_RenderHostTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <_RenderHostOutDir>@(_RenderHostTargetPath->'%(RootDir)%(Directory)')</_RenderHostOutDir>
      <_RenderHostFolder>%(RenderHostProject.Folder)</_RenderHostFolder>
    </PropertyGroup>
    <ItemGroup>
      <_RenderHostFiles Include="$(_RenderHostOutDir)**\*" />
      <!-- Files a newer build replaces. WinUI and MAUI shadow folders hard-link these, and copying over a file writes
           through the link into a running renderer's folder: delete first, so the link breaks instead (review L53). -->
      <_RenderHostReplaced Include="@(_RenderHostFiles)"
                           Condition="Exists('$(OutDir)renderhosts\$(_RenderHostFolder)\%(RecursiveDir)%(Filename)%(Extension)') And $([System.IO.File]::GetLastWriteTimeUtc('%(FullPath)').Ticks) &gt; $([System.IO.File]::GetLastWriteTimeUtc('$(OutDir)renderhosts\$(_RenderHostFolder)\%(RecursiveDir)%(Filename)%(Extension)').Ticks)" />
    </ItemGroup>
    <Delete Files="@(_RenderHostReplaced->'$(OutDir)renderhosts\$(_RenderHostFolder)\%(RecursiveDir)%(Filename)%(Extension)')" ContinueOnError="true" />
    <Copy SourceFiles="@(_RenderHostFiles)"
          DestinationFiles="@(_RenderHostFiles->'$(OutDir)renderhosts\$(_RenderHostFolder)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishRenderHosts" AfterTargets="Publish" Outputs="%(RenderHostProject.Identity)">
    <MSBuild Projects="@(RenderHostProject)" Targets="Publish"
             Properties="Configuration=$(Configuration);Platform=%(RenderHostProject.Platform);RuntimeIdentifier=win-x64;SelfContained=true;PublishReadyToRun=true;PublishDir=$([System.IO.Path]::GetFullPath('$(PublishDir)'))renderhosts\%(RenderHostProject.Folder)\"
             RemoveProperties="TargetFramework;WindowsAppSDKSelfContained" />
  </Target>

</Project>
