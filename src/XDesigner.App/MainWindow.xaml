<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="XDesigner.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:XDesigner.App.Controls"
    xmlns:vm="using:XDesigner.App.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="xDesigner">

  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <!-- Shell layout (§15.1). The title bar is drawn by the app (content extends into it) so it shares the Mica backdrop. -->
  <Grid>
  <Grid.RowDefinitions>
    <RowDefinition Height="Auto" />  <!-- title bar -->
    <RowDefinition Height="*" />
  </Grid.RowDefinitions>

  <!-- Title bar (§15.1): icon, title, menus and the document toolbar. Interactive parts are passthrough regions
       (MainWindow.Chrome.cs); the rest drags the window. -->
  <Grid x:Name="AppTitleBar" Height="48" ColumnSpacing="8" Padding="14,0,0,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="48" />
      <ColumnDefinition x:Name="CaptionButtonsColumn" Width="138" />
    </Grid.ColumnDefinitions>
    <Image Source="ms-appx:///Assets/AppIcon.ico" Width="16" Height="16" VerticalAlignment="Center" />
    <TextBlock x:Name="TitleText" Grid.Column="1" Text="xDesigner" VerticalAlignment="Center" MaxWidth="320"
               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
    <MenuBar x:Name="MainMenu" Grid.Column="2" VerticalAlignment="Center">
      <MenuBarItem Title="File">
        <MenuFlyoutItem Text="New project…" Click="NewProject_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE710;" /></MenuFlyoutItem.Icon>
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control,Shift" Key="N" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Open…" Click="OpenFile_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="O" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSubItem x:Name="RecentMenu" Text="Open recent" IsEnabled="False">
          <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutSubItem.Icon>
        </MenuFlyoutSubItem>
        <MenuFlyoutItem Text="Save" Click="Save_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="S" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Save all" Click="SaveAll_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEA35;" /></MenuFlyoutItem.Icon>
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control,Shift" Key="S" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Close" Click="Close_Click">
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="W" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem x:Name="SettingsMenuItem" Text="Settings…" Click="Settings_Click" KeyboardAcceleratorTextOverride="Ctrl+,">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="Exit" Click="Exit_Click" />
      </MenuBarItem>
      <MenuBarItem Title="Edit">
        <MenuFlyoutItem x:Name="UndoMenuItem" Text="Undo" Click="Undo_Click" KeyboardAcceleratorTextOverride="Ctrl+Z">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A7;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem x:Name="RedoMenuItem" Text="Redo" Click="Redo_Click" KeyboardAcceleratorTextOverride="Ctrl+Y">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7A6;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="Cut" Click="Cut_Click" KeyboardAcceleratorTextOverride="Ctrl+X">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C6;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Copy" Click="Copy_Click" KeyboardAcceleratorTextOverride="Ctrl+C">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Paste" Click="Paste_Click" KeyboardAcceleratorTextOverride="Ctrl+V">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE77F;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <!-- Ctrl+Z/Y/X/C/V and Del are handled in code only when no text box took the key first (MainWindow.Editing.cs). -->
        <MenuFlyoutItem Text="Delete" Click="Delete_Click" KeyboardAcceleratorTextOverride="Del">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
      </MenuBarItem>
      <MenuBarItem Title="View">
        <MenuFlyoutItem Text="Zoom in" Command="{x:Bind ViewModel.ZoomInCommand}">
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Add" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Zoom out" Command="{x:Bind ViewModel.ZoomOutCommand}">
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Subtract" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Actual size" Command="{x:Bind ViewModel.ResetZoomCommand}">
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control" Key="Number0" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Zoom to fit" Command="{x:Bind ViewModel.ZoomToFitCommand}" KeyboardAcceleratorTextOverride="Ctrl+9" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem x:Name="KeepSizeMenuItem" Text="Keep this preview size" Click="KeepSize_Click" IsEnabled="False" />
        <MenuFlyoutItem x:Name="ShowHiddenMenuItem" Text="Show hidden controls" Click="ShowHidden_Click" IsEnabled="False" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="Solution Explorer" Click="ShowSolutionExplorer_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F1;" /></MenuFlyoutItem.Icon>
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control,Menu" Key="L" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Error List" Click="ShowErrorList_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB90;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <ToggleMenuFlyoutItem x:Name="ShowToolboxMenuItem" Text="Toolbox" IsChecked="True" Click="TogglePane_Click" />
        <ToggleMenuFlyoutItem x:Name="ShowOutputMenuItem" Text="Output" IsChecked="True" Click="TogglePane_Click" />
      </MenuBarItem>
      <MenuBarItem Title="Project">
        <MenuFlyoutItem Text="Open project…" Click="OpenProject_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control,Shift" Key="O" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSubItem x:Name="ProjectFilesMenu" Text="Files" IsEnabled="False">
          <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutSubItem.Icon>
        </MenuFlyoutSubItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem x:Name="RebuildMenuItem" Text="Rebuild" Click="Rebuild_Click" IsEnabled="False">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE90F;" /></MenuFlyoutItem.Icon>
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Control,Shift" Key="B" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem x:Name="RunMenuItem" Text="Run" Click="Run_Click" IsEnabled="False">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" /></MenuFlyoutItem.Icon>
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="F5" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutItem x:Name="StopMenuItem" Text="Stop" Click="Stop_Click" IsEnabled="False">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71A;" /></MenuFlyoutItem.Icon>
          <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Modifiers="Shift" Key="F5" /></MenuFlyoutItem.KeyboardAccelerators>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem x:Name="AddWindowMenuItem" Text="Add window…" Click="AddWindow_Click" IsEnabled="False">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE737;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem x:Name="AddPageMenuItem" Text="Add page…" Click="AddPage_Click" Visibility="Collapsed">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7C3;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem x:Name="AddUserControlMenuItem" Text="Add user control…" Click="AddUserControl_Click" IsEnabled="False">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A1;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem x:Name="CloseProjectMenuItem" Text="Close project" Click="CloseProject_Click" IsEnabled="False" />
      </MenuBarItem>
      <MenuBarItem Title="Help">
        <MenuFlyoutItem Text="Report a problem or suggest an idea…" Click="ReportProblem_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xED15;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutItem Text="Open the settings and error log folder" Click="OpenDataFolder_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="License" Click="License_Click" />
        <MenuFlyoutItem Text="Third-party notices" Click="ThirdPartyNotices_Click" />
        <MenuFlyoutSeparator />
        <MenuFlyoutItem Text="About xDesigner" Click="About_Click">
          <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
        </MenuFlyoutItem>
      </MenuBarItem>
    </MenuBar>

    <!-- Document toolbar -->
    <StackPanel x:Name="TitleToolbar" Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
      <Button x:Name="OpenButton" Click="OpenFile_Click" ToolTipService.ToolTip="Open a .axaml file, or a project (.csproj, .sln) (Ctrl+O)">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE8E5;" FontSize="14" />
          <TextBlock Text="Open" />
        </StackPanel>
      </Button>
      <Button x:Name="RunButton" Click="Run_Click" IsEnabled="False" ToolTipService.ToolTip="Save, build and run the project (F5)"
              AutomationProperties.Name="Run">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE768;" FontSize="14" Foreground="{ThemeResource NotifySuccessIcon}" />
          <TextBlock x:Name="RunButtonText" Text="Run" />
        </StackPanel>
      </Button>
      <Button x:Name="StopButton" Click="Stop_Click" Visibility="Collapsed" ToolTipService.ToolTip="Stop the running app (Shift+F5)"
              AutomationProperties.Name="Stop">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE71A;" FontSize="14" Foreground="{ThemeResource NotifyErrorIcon}" />
          <TextBlock Text="Stop" />
        </StackPanel>
      </Button>
      <AppBarSeparator />
      <TextBlock Text="Theme" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <ComboBox x:Name="ThemeBox" MinWidth="110" SelectionChanged="ThemeBox_SelectionChanged" ToolTipService.ToolTip="Preview theme (doesn't change the file)">
        <x:String>Default</x:String>
        <x:String>Light</x:String>
        <x:String>Dark</x:String>
      </ComboBox>
      <TextBlock Text="Size" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" />
      <ComboBox x:Name="SizeBox" MinWidth="130" SelectionChanged="SizeBox_SelectionChanged" ToolTipService.ToolTip="Preview size (doesn't change the file; View › Keep this preview size writes it)" />
      <TextBlock Text="Zoom" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="8,0,0,0" />
      <ComboBox x:Name="ZoomBox" MinWidth="90" SelectionChanged="ZoomBox_SelectionChanged" />
    </StackPanel>
  </Grid>

  <Grid x:Name="Root" Grid.Row="1">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />  <!-- notification strip -->
      <RowDefinition Height="*" />     <!-- panes -->
      <RowDefinition Height="Auto" />  <!-- splitter -->
      <RowDefinition x:Name="OutputRow" Height="160" />   <!-- output -->
      <RowDefinition Height="Auto" />  <!-- status bar -->
    </Grid.RowDefinitions>

    <!-- Notification strip: slides open under the title bar (pushing the panes down) and closes by itself (D9). -->
    <Grid x:Name="NotifyHost" Height="0" Margin="8,0,8,0" PointerEntered="NotifyHost_PointerEntered" PointerExited="NotifyHost_PointerExited">
      <Border x:Name="NotifyStrip" Height="36" VerticalAlignment="Top" CornerRadius="{StaticResource ControlCornerRadius}"
              BorderThickness="1" Padding="12,0,4,0">
        <Grid ColumnSpacing="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <FontIcon x:Name="NotifyIcon" Glyph="&#xE73E;" FontSize="14" VerticalAlignment="Center" />
          <TextBlock x:Name="NotifyText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <StackPanel x:Name="NotifyActions" Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
          <Button Grid.Column="3" Click="NotifyClose_Click" Padding="8,4" Background="Transparent" BorderThickness="0"
                  VerticalAlignment="Center" ToolTipService.ToolTip="Dismiss" AutomationProperties.Name="Dismiss notification">
            <FontIcon Glyph="&#xE711;" FontSize="10" />
          </Button>
        </Grid>
      </Border>
    </Grid>

    <!-- Panes -->
    <Grid Grid.Row="1" Padding="8,0,8,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ToolboxColumn" Width="220" MinWidth="140" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="300" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="SideColumn" Width="340" MinWidth="240" />
      </Grid.ColumnDefinitions>

      <Border x:Name="ToolboxPaneBorder" Grid.Column="0" Style="{StaticResource PaneStyle}" Padding="0,0,0,4">
        <controls:ToolboxPane x:Name="Toolbox" />
      </Border>

      <toolkit:GridSplitter x:Name="ToolboxSplitter" Grid.Column="1" Width="8" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" />

      <Border Grid.Column="2" Style="{StaticResource PaneStyle}" Padding="0">
        <Grid>
          <TabView x:Name="Tabs"
                   TabItemsSource="{x:Bind ViewModel.Documents}"
                   SelectedItem="{x:Bind ViewModel.SelectedDocument, Mode=TwoWay}"
                   IsAddTabButtonVisible="False"
                   TabCloseRequested="Tabs_TabCloseRequested"
                   SelectionChanged="Tabs_SelectionChanged">
            <TabView.TabItemTemplate>
              <DataTemplate x:DataType="vm:DocumentViewModel">
                <TabViewItem Header="{x:Bind DisplayTitle, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind FilePath}">
                  <TabViewItem.IconSource><FontIconSource Glyph="&#xE737;" /></TabViewItem.IconSource>
                  <controls:DesignSurface Document="{x:Bind}" />
                </TabViewItem>
              </DataTemplate>
            </TabView.TabItemTemplate>
          </TabView>

          <StackPanel x:Name="NoDocuments" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
            <FontIcon Glyph="&#xE8E5;" FontSize="36" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Open a XAML file, project or solution to design it here" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="File › Open, Ctrl+O, or drop a file on this window." HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Open a file…" HorizontalAlignment="Center" Style="{StaticResource AccentButtonStyle}" Click="OpenFile_Click" />
            <StackPanel x:Name="RecentPanel" Spacing="2" Margin="0,16,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
              <TextBlock Text="Recent" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="12,0,0,4" />
              <StackPanel x:Name="RecentList" Spacing="0" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <toolkit:GridSplitter Grid.Column="3" Width="8" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" />

      <Grid Grid.Column="4" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <!-- Solution Explorer and Document Outline share the top pane. -->
        <Border Style="{StaticResource PaneStyle}" Padding="0,0,0,8">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <SelectorBar x:Name="SideTabs" Margin="4,0,4,0" SelectionChanged="SideTabs_SelectionChanged">
              <SelectorBarItem x:Name="SolutionTab" Text="Solution" />
              <SelectorBarItem x:Name="OutlineTab" Text="Outline" IsSelected="True" />
            </SelectorBar>
            <controls:SolutionExplorer x:Name="SolutionPane" Grid.Row="1" Visibility="Collapsed" />
            <controls:DocumentOutline x:Name="OutlinePane" Grid.Row="1" Document="{x:Bind ViewModel.SelectedDocument, Mode=OneWay}" />
          </Grid>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource PaneStyle}" Padding="0">
          <controls:PropertiesPane x:Name="Properties" Document="{x:Bind ViewModel.SelectedDocument, Mode=OneWay}" />
        </Border>
      </Grid>
    </Grid>

    <toolkit:GridSplitter x:Name="OutputSplitter" Grid.Row="2" Height="8" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" Background="Transparent" />

    <!-- Output -->
    <Border x:Name="OutputPaneBorder" Grid.Row="3" Style="{StaticResource PaneStyle}" Margin="8,0,8,0" Padding="0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Output (renderer, files) and Events (§9.7: every handler created, connected or disconnected). -->
        <SelectorBar x:Name="OutputTabs" Margin="4,0,4,0" SelectionChanged="OutputTabs_SelectionChanged">
          <SelectorBarItem x:Name="OutputTab" Text="Output" IsSelected="True" />
          <SelectorBarItem x:Name="BuildTab" Text="Build" />
          <SelectorBarItem x:Name="RunTab" Text="Run" />
          <SelectorBarItem x:Name="EventsLogTab" Text="Events" />
          <SelectorBarItem x:Name="ErrorsTab" Text="Error List" />
        </SelectorBar>
        <Grid x:Name="ErrorsPanel" Grid.Row="1" Visibility="Collapsed">
          <ListView x:Name="ErrorsList" ItemsSource="{x:Bind ViewModel.Diagnostics}" SelectionMode="Single" IsItemClickEnabled="False"
                    DoubleTapped="ErrorsList_DoubleTapped" KeyDown="ErrorsList_KeyDown" Padding="0,0,0,4">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="12,2" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:DiagnosticRow">
                <Grid ColumnSpacing="10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <FontIcon Glyph="{x:Bind Glyph}" FontSize="12" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Code}" FontSize="12" />
                  <TextBlock Grid.Column="2" Text="{x:Bind Message}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Message}" />
                  <TextBlock Grid.Column="3" Text="{x:Bind Location}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
          <TextBlock x:Name="NoErrorsText" Margin="12,6" Text="No errors or warnings in the last build. Double-click one to go to it."
                     Style="{StaticResource PanePlaceholderTextStyle}" />
        </Grid>
        <ListView x:Name="RunList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.RunLines}" SelectionMode="None" Padding="0,0,0,4" Visibility="Collapsed">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="Padding" Value="12,1" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLine">
              <TextBlock Text="{x:Bind Text}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <ListView x:Name="BuildList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.BuildLines}" SelectionMode="None" Padding="0,0,0,4" Visibility="Collapsed">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="Padding" Value="12,1" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLine">
              <TextBlock Text="{x:Bind Text}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <ListView x:Name="EventsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.EventLines}" SelectionMode="None" Padding="0,0,0,4" Visibility="Collapsed">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="Padding" Value="12,1" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLine">
              <TextBlock Text="{x:Bind Text}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
        <ListView x:Name="OutputList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.OutputLines}" SelectionMode="None" Padding="0,0,0,4">
          <ListView.ItemContainerStyle>
            <Style TargetType="ListViewItem">
              <Setter Property="MinHeight" Value="0" />
              <Setter Property="Padding" Value="12,1" />
            </Style>
          </ListView.ItemContainerStyle>
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="vm:LogLine">
              <TextBlock Text="{x:Bind Text}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Grid Grid.Row="4" Padding="12,4" ColumnSpacing="24">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.RendererStatus, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
      <TextBlock x:Name="StatusPath" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="StatusSelection" Grid.Column="2" Style="{StaticResource CaptionTextBlockStyle}" />
      <TextBlock x:Name="StatusZoom" Grid.Column="3" Style="{StaticResource CaptionTextBlockStyle}" />
      <ToggleButton x:Name="GridSnapToggle" Grid.Column="4" Padding="6,1" MinHeight="0" FontSize="12" Click="GridSnapToggle_Click"
                    ToolTipService.ToolTip="Snap positions and sizes to a grid (Settings sets its size)" AutomationProperties.Name="Snap to grid">
        <StackPanel Orientation="Horizontal" Spacing="4"><FontIcon Glyph="&#xE80A;" FontSize="11" /><TextBlock Text="Grid" /></StackPanel>
      </ToggleButton>
    </Grid>
  </Grid>
  </Grid>
</Window>
