<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The .NET MAUI render host (§14.6). This folder holds its source; this project builds it against MAUI 11, and
    ..\XDesigner.RenderHost.Maui10 builds the same source against MAUI 10 (each MAUI version pins its own Windows App SDK,
    so each has its own host). It is a MAUI app for Windows that runs the project's own MauiProgram, draws pages through
    MAUI's WinUI handlers and captures them like the WinUI host, whose surface and capture code it links.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>XDesigner.RenderHost.Maui11</AssemblyName>
    <MauiPackageVersion>$(Maui11Version)</MauiPackageVersion>
  </PropertyGroup>

  <Import Project="XDesigner.RenderHost.Maui.props" />

  <!--
    Parts of the Windows App SDK that MAUI 11 brings and the renderer never uses (AI, machine learning: onnxruntime and
    DirectML, Search, Widgets; about 53 MB), kept out as the app does. The versions are the ones MAUI 11.0.0 brings: after
    updating MAUI, use the new ones from objproject.assets.json (NuGet reports a downgrade otherwise).
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" VersionOverride="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.ML" VersionOverride="2.1.94" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Search" VersionOverride="2.5.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Widgets" VersionOverride="2.0.5" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.Windows.AI.MachineLearning" VersionOverride="2.1.74" ExcludeAssets="all" />
  </ItemGroup>

</Project>
