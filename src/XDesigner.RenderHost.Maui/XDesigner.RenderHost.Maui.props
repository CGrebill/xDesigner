<Project>

  <!-- What the MAUI hosts share; each project sets TargetFramework, AssemblyName and MauiPackageVersion first. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>XDesigner.RenderHost</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Program.Main parses the command line before anything starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <!-- LibraryImport (window hiding) generates pointer code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Out-of-process .NET MAUI renderer for the designer. One instance per open project.</Description>
    <_MauiHostSource>$(MSBuildThisFileDirectory)</_MauiHostSource>
    <_WinUIHostSource>$(MSBuildThisFileDirectory)..\XDesigner.RenderHost.WinUI\</_WinUIHostSource>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\VsThreadingWithoutWpf.targets" />

  <ItemGroup>
    <!-- The WinUI host's drawing surface and capture, and the font list, as linked source. -->
    <Compile Include="$(_WinUIHostSource)Hosting\RenderSurface.cs" Link="Linked\RenderSurface.cs" />
    <Compile Include="$(_WinUIHostSource)Rendering\FrameCapture.cs" Link="Linked\FrameCapture.cs" />
    <Compile Include="$(_WinUIHostSource)Metadata\FontList.cs" Link="Linked\FontList.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" VersionOverride="$(MauiPackageVersion)" />
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\XDesigner.Protocol\XDesigner.Protocol.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\XDesigner.RenderHost.Common\XDesigner.RenderHost.Common.csproj" />
  </ItemGroup>

</Project>
