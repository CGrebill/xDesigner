<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Avalonia render host (§14). This folder holds its source; this project builds it against Avalonia 12, and
    ..\XDesigner.RenderHost.Avalonia11 builds the same source against Avalonia 11 (one process can't load two Avalonia
    versions, so each major version has its own host).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>XDesigner.RenderHost.Avalonia12</AssemblyName>
    <RootNamespace>XDesigner.RenderHost</RootNamespace>
    <!-- Skia/HarfBuzz native assets must be present next to the exe. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Description>Out-of-process Avalonia 12 headless renderer for the designer. One instance per open project.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="StreamJsonRpc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XDesigner.Protocol\XDesigner.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XDesigner.RenderHost.Tests" />
  </ItemGroup>

</Project>
