<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SampleMauiApp.Pages.SettingsPage"
             Title="Settings">
  <VerticalStackLayout Padding="24" Spacing="12">
    <Label Text="Settings" FontSize="20" />
    <Switch x:Name="darkMode" IsToggled="True" />
    <Picker x:Name="language" Title="Language" SelectedIndex="0">
      <Picker.Items>
        <x:String>English</x:String>
        <x:String>Deutsch</x:String>
      </Picker.Items>
    </Picker>
  </VerticalStackLayout>
</ContentPage>
