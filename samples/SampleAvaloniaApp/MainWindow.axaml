<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:SampleAvaloniaApp.Controls"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="420"
        x:Class="SampleAvaloniaApp.MainWindow"
        Title="Sample Avalonia App"
        Width="640" Height="420">
  <Grid RowDefinitions="Auto,*,Auto" Margin="16">
    <TextBlock x:Name="titleText" Grid.Row="0" Text="Hello from Avalonia 12" FontSize="24" FontWeight="SemiBold" />

    <StackPanel Grid.Row="1" Spacing="12" Margin="0,16,0,0">
      <local:ContactCard x:Name="contactCard1" />
      <local:StarRating x:Name="starRating1" Value="3" Maximum="5" />
    </StackPanel>

    <Button x:Name="button1" Grid.Row="2" Content="Click me" HorizontalAlignment="Left" Click="button1_Click" />
  </Grid>
</Window>
