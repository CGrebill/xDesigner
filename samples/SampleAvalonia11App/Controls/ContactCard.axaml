<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="90"
             x:Class="SampleAvaloniaApp.Controls.ContactCard">
  <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="Gray">
    <StackPanel Spacing="4">
      <TextBlock x:Name="nameText" Text="Ada Lovelace" FontWeight="Bold" />
      <TextBlock x:Name="detailText" Text="Analyst, Engine No. 1" />
    </StackPanel>
  </Border>
</UserControl>
