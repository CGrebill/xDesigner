<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Code quality: the recommended .NET analyzers and the .editorconfig style rules run in every build. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Product information (file properties of every assembly, the About box, the installer). -->
    <Product>xDesigner</Product>
    <Company>CGrebill</Company>
    <Authors>CGrebill</Authors>
    <Copyright>Copyright 2026 CGrebill</Copyright>
    <Version>2.0.1</Version>
    <!-- Where the source is published; also the "Report a problem" link in the app (Help menu). -->
    <RepositoryUrl>https://github.com/CGrebill/xDesigner</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
